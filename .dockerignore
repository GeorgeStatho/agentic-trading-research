certbot/
.git/
__pycache__/
Data/logs/
*.pyc
*.pyo
*.pyd

# Compose injects these at runtime through env_file, so the image never needs them.
# Copying them in bakes credentials into every layer and makes the build's test run
# read the operator's tuned values instead of the shipped defaults it asserts.
.env
.env.*
!.env.example
