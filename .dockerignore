certbot/
# Not used by the Python image: the dashboard builds from its own context, and the saved
# pages are reference material. Excluding them keeps the build context small and fast to walk.
web_dashboard/
html_pages/
graft/
.pytest_cache/
.superpowers/
.git/
__pycache__/
Data/logs/
*.pyc
*.pyo
*.pyd
# A developer's changed-test map; the image build always runs the full suite.
.testmondata*
.testmon-inputs.json

# Compose injects these at runtime through env_file, so the image never needs them.
# Copying them in bakes credentials into every layer and makes the build's test run
# read the operator's tuned values instead of the shipped defaults it asserts.
.env
.env.*
!.env.example

# Local database backups and snapshots (gigabytes). Runtime data lives in the db_data volume.
stock-backup-*
*.tgz
*.db.gz
# Outputs of local runs. An image that ships one serves it until the container writes its own.
Data/*_output.json
# Google Cloud service-account keys must never be copied into an image.
agentic-stock-research-*.json
