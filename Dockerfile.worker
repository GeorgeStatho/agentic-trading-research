FROM python:3.11-slim AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    libffi-dev \
    libssl-dev \
    libxml2-dev \
    libxslt1-dev \
    zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN python -m pip install --upgrade pip setuptools wheel
RUN pip wheel --no-cache-dir --wheel-dir /wheels -r requirements.txt


FROM python:3.11-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

COPY --from=builder /wheels /wheels
RUN python -m pip install --upgrade pip setuptools wheel \
    && pip install /wheels/* \
    && rm -rf /wheels

RUN playwright install --with-deps chromium

COPY . .

# PYTHONDONTWRITEBYTECODE stops Python writing .pyc files but it still reads them, so
# compiling the project here saves every process (including each scrape subprocess)
# from recompiling the modules it imports.
RUN python -m compileall -q -x /node_modules/ /app

# Registers the import roots declared in pyproject.toml; dependencies are already installed.
RUN pip install --no-deps -e .

RUN python scripts/project.py test

CMD ["python", "Python Scripts/main.py"]
