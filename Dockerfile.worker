# syntax=docker/dockerfile:1
# Pinned by digest: an unpinned tag moves whenever upstream publishes a patch release and
# throws away every cached layer (apt, wheels, Playwright: ~13 minutes). Bump it deliberately.
FROM python:3.11-slim@sha256:9635410349cba3531fabde484e07f14e625abb40e1bc8b23fffa046cb497ce2d AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    libffi-dev \
    libssl-dev \
    libxml2-dev \
    libxslt1-dev \
    zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt constraints.txt ./
RUN python -m pip install --upgrade pip setuptools wheel
RUN pip wheel --no-cache-dir --wheel-dir /wheels -r requirements.txt -c constraints.txt


FROM python:3.11-slim@sha256:9635410349cba3531fabde484e07f14e625abb40e1bc8b23fffa046cb497ce2d

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

COPY --from=builder /wheels /wheels
RUN python -m pip install --upgrade pip setuptools wheel \
    && pip install /wheels/* \
    && rm -rf /wheels

RUN playwright install --with-deps chromium

# The build's test step runs in parallel when pytest-xdist is present (versions from constraints.txt).
# Installed before COPY so code changes reuse this cached layer.
COPY constraints.txt .
RUN pip install pytest pytest-xdist -c constraints.txt

COPY . .

# PYTHONDONTWRITEBYTECODE stops Python writing .pyc files but it still reads them, so
# compiling the project here saves every process (including each scrape subprocess)
# from recompiling the modules it imports.
RUN python -m compileall -q -x /node_modules/ /app

# Registers the import roots declared in pyproject.toml; dependencies are already installed.
RUN pip install --no-deps -e .

# The tests create SQLite databases in /tmp; every fsync on the container filesystem is slow
# enough to stretch a ~25 s suite past 20 minutes, so give them a tmpfs.
RUN --mount=type=tmpfs,target=/tmp python scripts/project.py test

CMD ["python", "Python Scripts/main.py"]
