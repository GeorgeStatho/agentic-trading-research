# =============================================================================
# 1. ACCOUNTS AND KEYS
# =============================================================================
# Alpaca
PUBLIC_KEY=your_alpaca_public_key
PRIVATE_KEY=your_alpaca_private_key
ALPACA_PAPER=true

# marketdata.app token for end-of-day option quotes (section 9).
MARKETDATA_TOKEN=your_token_here

#paper trading accounts that run side by side
TRADING_ACCOUNTS=spreads,itm,longer,shares

ACCOUNT_SPREADS_PUBLIC_KEY=...
ACCOUNT_SPREADS_PRIVATE_KEY=...
ACCOUNT_SPREADS_STRATEGY=debit_spread

ACCOUNT_ITM_PUBLIC_KEY=...
ACCOUNT_ITM_PRIVATE_KEY=...
ACCOUNT_ITM_STRATEGY=itm_single

ACCOUNT_LONGER_PUBLIC_KEY=...
ACCOUNT_LONGER_PRIVATE_KEY=...
ACCOUNT_LONGER_STRATEGY=longer_dte

ACCOUNT_SHARES_PUBLIC_KEY=...
ACCOUNT_SHARES_PRIVATE_KEY=...




# Google AI Studio key, for stages using the 'gemini' provider (section 2).
# 'gemini' calls the Gemini API with an AI Studio key (https://aistudio.google.com/apikey). Its free tier
# (about 15 requests/min and 500/day for Flash-Lite, unpublished and subject to change) may train on prompts.
# GEMINI_API_KEY=

# 'openai_compatible' is any hosted Chat Completions API. Mistral's free Experiment plan (about 1B tokens/month,
# phone verification, may train on prompts) handles this volume; Groq or OpenRouter work the same way.
# OPENAI_COMPATIBLE_BASE_URL=https://api.mistral.ai/v1
# OPENAI_COMPATIBLE_API_KEY=

# OPENAI_API_KEY=your_openai_api_key

# Telemetry receiver tokens (only used if you host the receiver).
# TELEMETRY_RECEIVER_WRITE_AUTH_TOKEN=optional_write_token_if_you_do_not_want_public_startup_pings
# TELEMETRY_RECEIVER_READ_AUTH_TOKEN=strong_private_token_for_/api/telemetry/summary
# TELEMETRY_RECEIVER_AUTH_TOKEN=legacy_fallback_token_for_summary_reads


# =============================================================================
# 2. MODEL PROVIDERS
# =============================================================================
# Google Cloud / Vertex AI
LLM_PROVIDER=vertex
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=global

# Local Docker uses the host gcloud ADC directory automatically.
# Run `gcloud auth application-default login --scopes=https://www.googleapis.com/auth/cloud-platform`
# on the host once, then rebuild/restart the containers.
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp-sa.json

# Gemini 2.5 retires on Vertex AI on 2026-10-20; requests to it fail after that.
# VERTEX_DEFAULT_MODEL is only a fallback: the exposure map, research planner, researcher, and any
# stage whose *_MODEL below is unset. Setting it does not move the stages below; change those too.
# Blank uses the code default, gemini-3.8-flash.
VERTEX_DEFAULT_MODEL=gemini-3.8-flash
# Gemini 3+ only (Gemini 2.5 requests are unchanged). Google recommends temperature 1.0 for
# Gemini 3: lower values can loop or degrade reasoning. This replaces every stage's own
# temperature on Gemini 3+ models, including THESIS_VALIDATOR_TEMPERATURE. Leave it blank to keep
# each stage's temperature (0 for the pipeline stages) and accept that risk for repeatability.
VERTEX_GEMINI3_TEMPERATURE=1.0
# Gemini 3+ thinking level for any call whose stage sets no <STAGE>_THINKING_LEVEL below:
# minimal | low | medium | high, or blank for the model default (medium on gemini-3.8-flash).
# Thinking tokens bill as output. gemini-3.8-flash has no minimal; it is sent as low.
VERTEX_THINKING_LEVEL=
# Optional Vertex retry tuning
# VERTEX_MAX_ATTEMPTS=5
# VERTEX_RETRY_INITIAL_DELAY_SECONDS=2
# VERTEX_RETRY_MAX_DELAY_SECONDS=30
# MACRO_NEWS_BATCH_PAUSE_SECONDS=0.75

# Optional per-stage provider; blank uses LLM_PROVIDER. Same names for STRATEGIST, MANAGER, THESIS_VALIDATOR.
# Macro news reads MACRO_NEWS_PROVIDER, then WORLD_NEWS_PROVIDER. Other stages never inherit the news stages' provider.

# Mid-tier reasoning stage. gemini-3.8-flash: $0.75/$3.75 through 2026-12-31, then $1.50/$7.50.
STRATEGIST_MODEL=gemini-3.8-flash
STRATEGIST_THINKING_LEVEL=low

# Final decision stage. gemini-3.8-flash is cheaper per token than 2.5 Pro ($1.25/$10);
# gemini-3.1-pro ($2/$12) is the like-for-like Pro successor.
# THESIS_VALIDATOR_THINKING_LEVEL falls back to MANAGER_THINKING_LEVEL.
MANAGER_MODEL=gemini-3.8-flash
MANAGER_THINKING_LEVEL=medium

# Settings for stages on 'openai_compatible' (section 1 has its URL and key).
# Replaces each stage's temperature (0), which can make reasoning models loop; blank keeps the stage's own.
# OPENAI_COMPATIBLE_TEMPERATURE=1.0
# Reasoning effort sent to OpenRouter (none, minimal, low, medium, high, xhigh, max); blank uses the provider default.
# OPENAI_COMPATIBLE_REASONING_EFFORT=high
# Caps answer plus reasoning tokens per call, so a looping model stops early.
# OPENAI_COMPATIBLE_MAX_TOKENS=32000
# OpenRouter providers to try first (comma-separated); others are used only if these fail.
# Each call's upstream provider, tokens and cost are stored in the llm_call_usage table.
# OPENAI_COMPATIBLE_PROVIDER_ORDER=wafer
# false keeps calls on the PROVIDER_ORDER list only; true (default) lets OpenRouter use any other provider.
# OPENAI_COMPATIBLE_PROVIDER_FALLBACKS=false
# Hard price ceiling "prompt,completion" in $ per million tokens; providers above it are never used.
# OPENAI_COMPATIBLE_MAX_PRICE=0.15,0.60

# News classifiers
# High-volume classification/extraction stages use Flash-Lite to keep costs down.
# gemini-3.1-flash-lite ($0.25/$1.50 per 1M in/out tokens) is Google's 2.5 Flash-Lite successor.
# 2.5 Flash-Lite ($0.10/$0.40) did not think by default; keep these at low to limit output tokens.
WORLD_NEWS_MODEL=gemini-3.1-flash-lite
MACRO_NEWS_MODEL=gemini-3.1-flash-lite
SECTOR_OPPURUNTIST_MODEL=gemini-3.1-flash-lite
INDUSTRY_OPPURUNTINST_MODEL=gemini-3.1-flash-lite
COMPANY_OPPURUNTIST_MODEL=gemini-3.1-flash-lite
# Macro news reads MACRO_NEWS_THINKING_LEVEL, then WORLD_NEWS_THINKING_LEVEL.
WORLD_NEWS_THINKING_LEVEL=low
SECTOR_OPPURUNTIST_THINKING_LEVEL=low
INDUSTRY_OPPURUNTINST_THINKING_LEVEL=low
COMPANY_OPPURUNTIST_THINKING_LEVEL=low
# To run the classifiers on the Gemini API free tier (needs GEMINI_API_KEY):
# WORLD_NEWS_PROVIDER=gemini
# SECTOR_OPPURUNTIST_PROVIDER=gemini
# INDUSTRY_OPPURUNTINST_PROVIDER=gemini
# COMPANY_OPPURUNTIST_PROVIDER=gemini
# Catalyst classifier: a cheap model labels catalysts the headline rules left in needs_review (docs/finharness/
# PLAN_A_CATALYST_CLASSIFIER.md). Its model inherits COMPANY_OPPURUNTIST_* unless CATALYST_CLASSIFIER_MODEL (or
# _PROVIDER, _THINKING_LEVEL) is set. Keep it off until `python3 scripts/catalysts.py classify` and `review` look right.
CATALYST_CLASSIFIER_ENABLED=false
CATALYST_CLASSIFIER_MAX_PER_CYCLE=200
# When a news classification call is refused for quota or capacity (daily cap, or per-minute/overload retries
# used up), it is asked of each CLASSIFIER_FALLBACKS provider:model in order. Free Gemini quotas are per model,
# so another Flash-Lite version is a fresh daily allowance. The model that answered is stored in each
# *_article_processing row (model column, raw_json.answered_by). Empty disables it; strategist/manager never use it.
# CLASSIFIER_FALLBACKS=gemini:gemini-3.5-flash-lite,openai_compatible:mistral-small-latest
# The company opportunist sends many articles per request (each body capped at
# COMPANY_OPPORTUNIST_ARTICLE_BODY_CHAR_LIMIT, default 1200 chars), since free tiers cap requests per day long
# before tokens. Token budget per request: blank = 16000 for hosted providers, 4096 for llamacpp/ollama.
# CLASSIFIER_BATCH_TOKENS=

# Exposure map
# The exposure map uses the current provider's configured default model.
# OpenAI defaults to gpt-5.6-terra; Vertex uses VERTEX_DEFAULT_MODEL; Ollama uses
# EXPOSURE_MAP_OLLAMA_MODEL or RESEARCHER_MODEL. EXPOSURE_MAP_MODEL overrides all of them.
# EXPOSURE_MAP_MODEL=
# EXPOSURE_MAP_OLLAMA_MODEL=llama3.1

# Optional local llama.cpp server (LLM_PROVIDER=llamacpp), e.g. for offline replays/backtests:
#   llama-server -m model.gguf -c 32768 -np 1 -ngl 99 --jinja --port 8080
# One server hosts one model; *_MODEL values are recorded but the server picks the model.
# Context is split across -np slots, so keep -c / -np large enough for manager prompts.
# LLAMACPP_BASE_URL=http://127.0.0.1:8080/v1

# Optional local Ollama fallback
# Uncomment these if you want to run with LLM_PROVIDER=ollama instead.
# OLLAMA_HOST=http://ollama:11434
# WORLD_NEWS_OLLAMA_HOST=http://ollama:11434
# MACRO_NEWS_OLLAMA_HOST=http://ollama:11434
# SECTOR_OPPURUNTIST_OLLAMA_HOST=http://ollama:11434
# INDUSTRY_OPPURUNTINST_OLLAMA_HOST=http://ollama:11434
# COMPANY_OPPURUNTIST_OLLAMA_HOST=http://ollama:11434
# STRATEGIST_OLLAMA_HOST=http://ollama:11434
# MANAGER_OLLAMA_HOST=http://ollama:11434


# =============================================================================
# 3. WORKER CYCLE AND ENTRY RULES
# =============================================================================
RUN_INTERVAL_SECONDS=1800
NEWS_COLLECTION_INTERVAL_SECONDS=3600
PIPELINE_RANKING_MAX_AGE_DAYS=7
MAIN_LOOP_ENTRY_COOLDOWN_SECONDS_AFTER_MARKET_OPEN=3600
# Reuse the strategist's last answer for a company when its evidence, model, prompt version and regime
# state are unchanged, the answer is younger than this many minutes and the price moved less than
# STRATEGIST_REUSE_MAX_PRICE_MOVE_PCT. 0 disables reuse (every cycle asks the model).
STRATEGIST_REUSE_MAX_AGE_MINUTES=0
STRATEGIST_REUSE_MAX_PRICE_MOVE_PCT=2.0
IMMEDIATE_OPTION_EXECUTION=true
EXECUTE_MEDIUM_CONFIDENCE_TRADES=false
OPTION_SELECTOR_MODE=hybrid
ALLOW_RISKY_SIMPLE_FALLBACK=false   # code default: true
MANAGER_OPTION_CHAIN_LIMIT_PER_TYPE=7
# Contracts per type fetched after the manager decides, for the contract selector only.
# MANAGER_OPTION_SELECTION_LIMIT_PER_TYPE=30
# Optional: fetch a wider raw chain from Alpaca, then trim to nearest/OTM contracts.
# MANAGER_OPTION_CHAIN_FETCH_MULTIPLIER=6


# =============================================================================
# 4. SIZING AND PORTFOLIO LIMITS
# =============================================================================
AGENT_OPTION_ORDER_QTY=1
MAX_OPTION_ORDER_QTY=100
MAX_OPTION_ORDER_QTY_MULTIPLIER=100
MAX_DEPLOYABLE_BUYING_POWER_PCT=65
PER_ORDER_SIZING_BUYING_POWER_PCT=45
# Hard ceiling on one entry's total premium. Unlike PER_ORDER_SIZING_BUYING_POWER_PCT
# this also refuses the trade when a single contract already costs more than the
# allowance, instead of buying one anyway. Live May-Sep 2026 results: entries above
# ~$1,000 of premium returned -27% (and the two multi-contract orders were the two
# worst losses) while mid-sized entries were net positive.
# Both limits are optional and the tighter one wins; set either to 0 to disable it.
# The absolute limit matters on a small account, whose buying power swings enough that
# a percentage ceiling alone drifts across the premium range the strategy trades.
#
# Replayed over the live May-Sep 2026 record, this pair keeps 26 of 33 entries and
# turns -$636 into +$408. Raising the absolute limit toward $1,000 keeps every winner
# (+$506 replay) at the cost of a larger single bet; dropping it below ~$800 starts
# cutting into the $710-760 premium band where the winners cluster.
MAX_PREMIUM_PER_TRADE_PCT=55
MAX_PREMIUM_PER_TRADE_DOLLARS=800

# Deterministic live/paper entry guardrails. MAX_DEPLOYABLE_BUYING_POWER_PCT above is
# the total option-notional cap; sector exposure is measured against it.
MAX_CONCURRENT_OPTION_POSITIONS=5
MAX_OPTION_SECTOR_EXPOSURE_PCT=100
DAILY_OPTION_LOSS_LIMIT_DOLLARS=300

# Per-underlying churn brakes: cap entry attempts per rolling window, and sit out a
# cooldown after a stop-loss exit in that underlying. 0 disables that brake.
#
# Both ship DISABLED because the live May-Sep 2026 record argues against them:
# re-entries within 7 days of a stop averaged -$8 (40% win rate) versus -$24 (35%)
# for fresh entries, so same-name follow-ups were the better trades, not the worse
# ones. Replaying "2 per 7 days + 7-day cooldown" over that record turns -$636 into
# -$1,428, because it blocks the two same-week NVDA re-entries that returned +$663
# and +$1,055. Enable these only if a larger sample shows churn actually costs money.
MAX_OPTION_ENTRIES_PER_SYMBOL_PER_WINDOW=0
OPTION_SYMBOL_ENTRY_WINDOW_DAYS=7
OPTION_SYMBOL_STOP_LOSS_COOLDOWN_DAYS=0


# =============================================================================
# 5. ENTRY GATES  (shadow = record only, enforce = block)
# =============================================================================
# V2 entry gates. The live server requests enforce for these four gates. A requested enforce stays
# shadow (and logs why) until research_gate_promotions holds a matching proof for the gate's current
# thresholds and source; see docs/RESEARCH_GUIDE.md.
EVIDENCE_CONTINUATION_ENABLED=true
EVIDENCE_CONTINUATION_MODE=enforce
EVIDENCE_CONTINUATION_REQUIRED_EVIDENCE_COUNT=2
EVIDENCE_CONTINUATION_REQUIRED_INDEPENDENT_SOURCES=2
EVIDENCE_CONTINUATION_MIN_EVIDENCE_SCORE=0.65
EVIDENCE_CONTINUATION_REQUIRE_SECTOR_OUTPERFORMANCE=true
EVIDENCE_CONTINUATION_REQUIRE_STOCK_RELATIVE_STRENGTH=true
EVIDENCE_CONTINUATION_MIN_RELATIVE_VOLUME=1.25
EVIDENCE_CONTINUATION_MAX_OVEREXTENSION=medium
EVIDENCE_CONTINUATION_ALLOWED_CALL_QUALITIES=good,excellent
EVIDENCE_CONTINUATION_ALLOWED_PUT_QUALITIES=good,excellent
EVIDENCE_CONTINUATION_FAIL_CLOSED_ON_MISSING_DATA=true
MARKET_REGIME_GATE_MODE=enforce

# V2 catalyst gates: shadow records verdicts; enforce blocks admission; disabled records diagnostics only.
# Decay hypotheses are versioned calendar-minute priors, not calibrated trading-day estimates.
V2_PROVENANCE_MODE=enforce
V2_FRESHNESS_MODE=enforce

# Phase 4 structured evidence theses. See docs/RESEARCH_PHASE4.md.
# off keeps the legacy strategist contract; shadow records checks and would-block gate verdicts;
# enforce stays shadow until a matching EVIDENCE_THESIS promotion proof exists.
EVIDENCE_THESIS_MODE=shadow

# Phase 5 trade economics: prices the manager's selected contract after declared costs before
# final entry permission. off attaches no gate; shadow records reports and would-block verdicts;
# enforce stays shadow until a matching TRADE_ECONOMICS promotion proof exists.
TRADE_ECONOMICS_MODE=shadow
# Black-Scholes repricing rate (decimal, annual), shared by the Part 5 scenario scorer and trade
# economics. Part of both policy hashes and every report.
OPTION_RISK_FREE_RATE=0.04
# A report older than this cannot authorize an enforced entry at submission.
TRADE_ECONOMICS_REPORT_VALIDITY_SECONDS=900
# The base IV change and minimum sample count are shared with V2_SCENARIO_IV_CHANGE and
# V2_EXPECTED_MOVE_MIN_SAMPLES.


# =============================================================================
# 6. OPEN-POSITION MANAGEMENT AND EXITS
# =============================================================================
WORKER_AUTO_MANAGE_OPTION_POSITIONS=false
OPTION_MANAGER_AUTO_MANAGE_OPTION_POSITIONS=true
AUTO_MANAGE_OPTION_POSITIONS=true
AUTO_CLOSE_OPTION_POSITIONS=true
OPTION_POSITION_MANAGEMENT_INTERVAL_SECONDS=25

# Default take-profit / stop-loss, then per days-to-expiration bucket.
OPTION_POSITION_TAKE_PROFIT_PCT=45
OPTION_POSITION_STOP_LOSS_PCT=-35
OPTION_POSITION_EXIT_HOURS_TO_EXPIRATION=75
# DTE bucket-specific thresholds follow the current registry: 12_20, 20_30, 30_45, 45_60.
OPTION_POSITION_12_20_DTE_TAKE_PROFIT_PCT=35
OPTION_POSITION_12_20_DTE_STOP_LOSS_PCT=-25
OPTION_POSITION_20_30_DTE_TAKE_PROFIT_PCT=55
OPTION_POSITION_20_30_DTE_STOP_LOSS_PCT=-30
OPTION_POSITION_30_45_DTE_TAKE_PROFIT_PCT=70
OPTION_POSITION_30_45_DTE_STOP_LOSS_PCT=-35
OPTION_POSITION_45_60_DTE_TAKE_PROFIT_PCT=85
OPTION_POSITION_45_60_DTE_STOP_LOSS_PCT=-40

# Consecutive management cycles the broker P/L must stay at or below the stop-loss
# floor before a full exit fires. 1 = sell on the first breach (legacy behavior);
# raise it (e.g. 2-3) to ride out momentary dips that bounce back before selling.
OPTION_POSITION_STOP_LOSS_CONFIRM_CHECKS=3
# Minimum adverse move in the underlying (fraction of the entry stock price) before
# a broker-P/L stop-loss breach counts as real. 0 = disabled (premium-only stop).
# e.g. 0.015 only stops a call once the stock is down >=1.5% from entry (or a put's
# stock is up >=1.5%), so IV crush / spread noise on the option can't force an exit
# while the stock itself is still fine. Falls back to the premium stop when the
# entry underlying baseline is unavailable or untrusted.
OPTION_POSITION_STOP_LOSS_UNDERLYING_MOVE_PCT=0.015

# Submit exits as spread-aware limit orders instead of market orders: passive at
# the option midpoint to capture spread, marketable at the bid for urgent
# (stop-loss / near-expiration) or already-retried exits. false = market orders
# (legacy behavior). Falls back to a market order if the option quote is unusable.
OPTION_POSITION_EXIT_USE_LIMIT_ORDERS=true
# Liquidity guard: hold a non-urgent exit (scale-out, momentum, trailing stop) for
# another cycle when the option bid/ask spread exceeds this fraction of the mid,
# rather than paying up into a blown-out book. Hard risk exits always bypass it.
# 0 disables the guard. e.g. 0.10 = skip non-urgent exits while the spread is >10%.
OPTION_POSITION_EXIT_MAX_SPREAD_PCT=0.15
# Tick sizes used to round limit-exit prices to a broker-valid increment (sell
# limits round DOWN). Defaults are the OCC standard: a nickel below the price
# threshold, a dime at/above it. Valid for any option class. For penny-quoted
# names (SPY, QQQ, ...) set both tick sizes to 0.01 to keep full precision.
OPTION_POSITION_EXIT_TICK_SIZE_SMALL=0.05
OPTION_POSITION_EXIT_TICK_SIZE_LARGE=0.10
OPTION_POSITION_EXIT_TICK_PRICE_THRESHOLD=3.00

# Volatility-scaled exit thresholds: multiply the stop-loss, take-profit, and
# underlying-move gate by the underlying's daily ATR relative to a baseline, so a
# fixed -25% stop widens on a high-vol name and tightens on a calm one. false =
# fixed thresholds. Falls back to fixed (scale 1.0) whenever the ATR can't be read.
OPTION_POSITION_VOLATILITY_SCALED_THRESHOLDS=true
# The daily ATR (as a fraction of the stock price) that maps to a 1.0x scale, e.g.
# 0.02 = a name whose average daily range is 2% of price keeps its base thresholds.
OPTION_POSITION_VOLATILITY_BASELINE_ATR_PCT=0.02
# Clamp on the scale multiplier so thresholds can't run away in either direction.
OPTION_POSITION_VOLATILITY_MIN_SCALE=0.5
OPTION_POSITION_VOLATILITY_MAX_SCALE=2.0
# ATR lookback: number of bars averaged and calendar days of daily history fetched.
OPTION_POSITION_VOLATILITY_ATR_PERIOD=14
OPTION_POSITION_VOLATILITY_ATR_LOOKBACK_DAYS=40

# Trailing-profit / dynamic exit settings
# Enables the trailing-profit exit workflow for open option positions.
OPTION_POSITION_ENABLE_TRAILING_PROFIT=true
# Runs the trailing-profit workflow without submitting live sell orders.
OPTION_POSITION_TRAILING_PROFIT_DRY_RUN=false
# Allows exits when the underlying stock momentum turns unfavorable.
OPTION_POSITION_ENABLE_MOMENTUM_EXIT=true
# Start tracking momentum history only after the position's max unrealized profit reaches this ratio.
OPTION_MOMENTUM_HISTORY_ENABLE_AFTER_PNL_PCT=2.00
# Number of recent momentum samples to keep per open position.
OPTION_MOMENTUM_HISTORY_WINDOW_SIZE=10
# Minimum number of samples required before momentum-history exits are allowed.
OPTION_MOMENTUM_HISTORY_MIN_SAMPLES=5
# Full-exit threshold based on how many recent samples in the window are `bad`.
OPTION_MOMENTUM_HISTORY_BAD_COUNT_EXIT_THRESHOLD=6
# Full-exit threshold based on how many `bad` samples happen in a row.
OPTION_MOMENTUM_HISTORY_CONSECUTIVE_BAD_EXIT_THRESHOLD=3
# If option premium gives back at least this much from its tracked peak, option-price momentum is marked bad.
OPTION_PRICE_MOMENTUM_BAD_GIVEBACK_THRESHOLD=0.25
# If option premium gives back at least this much from peak but stays below the bad threshold, it is marked mixed.
OPTION_PRICE_MOMENTUM_MIXED_GIVEBACK_THRESHOLD=0.15
# Minimum option profit ratio needed for the option-price momentum helper to treat the premium as clearly good.
OPTION_PRICE_MOMENTUM_GOOD_PROFIT_THRESHOLD=0.10
# Minutes before an unresolved pending exit order is considered stale.
OPTION_PENDING_EXIT_STALE_MINUTES=10
# When true, stale pending exit orders are cancelled so the manager can reevaluate cleanly.
OPTION_PENDING_EXIT_CANCEL_ON_STALE=true

# Profit threshold that must be reached before trailing protection turns on.
# Live May-Sep 2026 results drove this down from 0.55: winners commonly peaked in
# the +20..+50% band and round-tripped into a stop before protection ever armed.
# Floors only ratchet upward, so arming early banks those trades without capping
# the occasional +100%+ runner.
OPTION_TRAIL_PROTECTION_TRIGGER_PCT=0.30   # code default: 0.20
# Minimum locked-in profit once trailing protection is first activated.
OPTION_TRAIL_INITIAL_FLOOR_PCT=0.15   # code default: 0.05
# Profit threshold where bucket-based dynamic giveback trailing starts tightening the floor.
OPTION_TRAIL_DYNAMIC_GIVEBACK_START_PCT=0.50

# Profit threshold for the first partial scale-out sale.
OPTION_TRAIL_FIRST_SCALE_OUT_TRIGGER_PCT=0.50
# Fraction of the open position to sell on the first scale-out.
OPTION_TRAIL_FIRST_SCALE_OUT_FRACTION=0.50

# Profit threshold for the second partial scale-out sale.
OPTION_TRAIL_SECOND_SCALE_OUT_TRIGGER_PCT=1.00
# Fraction of the original position to sell on the second scale-out.
OPTION_TRAIL_SECOND_SCALE_OUT_FRACTION=0.25

# Bucket-specific giveback allowed after trailing protection is active.
# Higher values allow more pullback before the trailing exit fires. Only the current buckets are
# read; older OPTION_TRAIL_3_7/7_14/14_30 keys no longer match a bucket and have no effect.
OPTION_TRAIL_12_20_GIVEBACK_PCT=0.35
OPTION_TRAIL_20_30_GIVEBACK_PCT=0.45
OPTION_TRAIL_30_45_GIVEBACK_PCT=0.27
OPTION_TRAIL_45_60_GIVEBACK_PCT=0.30

# Profit floors that tighten protection once a position reaches very large gains.
OPTION_TRAIL_100_FLOOR_PCT=0.75
OPTION_TRAIL_150_FLOOR_PCT=1.30
OPTION_TRAIL_200_FLOOR_PCT=1.70


# =============================================================================
# 7. THESIS VALIDATOR AND EVENT REVIEW  (use the manager's model by default)
# =============================================================================
# LLM thesis validator (see docs/archive/LLMThesisValidator.md)
# Daily per-position thesis adjudication after the configured ET time.
# Mode: off = never runs; shadow = runs the full pipeline and records verdicts
# to the DB but NEVER trades (default); live = LLM-invalidated theses may close
# or trim positions, subject to the daily exit cap and kill switch below.
THESIS_VALIDATOR_MODE=shadow
# Emergency stop read at container startup: true downgrades every would-be
# LLM-initiated exit to a flag-only record, even in live mode.
THESIS_VALIDATOR_KILL_SWITCH=false
# Earliest America/New_York time the daily run may start (HH:MM).
THESIS_VALIDATOR_RUN_AFTER_ET=15:30
# Consistency gate: samples per position and sampling temperature (keep 0.3-0.5;
# non-zero on purpose so disagreement between samples stays visible). On Gemini 3+ models
# VERTEX_GEMINI3_TEMPERATURE replaces this unless that is blank; expect more sample disagreement at 1.0.
THESIS_VALIDATOR_SAMPLES=3
THESIS_VALIDATOR_TEMPERATURE=0.4
# Max articles included per evidence pack.
THESIS_VALIDATOR_NEWS_LIMIT=10
# Circuit breaker: max LLM-initiated exits per trading day (live mode only).
THESIS_VALIDATOR_MAX_DAILY_EXITS=2
# Model/provider override; falls back to MANAGER_MODEL / MANAGER_OLLAMA_HOST.
# THESIS_VALIDATOR_MODEL=gemini-3.1-pro
# THESIS_VALIDATOR_OLLAMA_HOST=http://ollama:11434

# Phase 6: material events for a company with an open position (discovery position_review items,
# so DISCOVERY_MODE=shadow) get a thesis review without waiting for the daily schedule. Reuses the
# validator's model, samples and evidence pack. off | shadow; shadow never executes an exit, even
# when THESIS_VALIDATOR_MODE=live.
EVENT_THESIS_REVIEW_MODE=shadow
# Wait this long after an event's latest revision so a burst of updates is reviewed once.
EVENT_THESIS_REVIEW_DEBOUNCE_SECONDS=900
# Model-backed event reviews per open position per New York trading day.
EVENT_THESIS_REVIEW_DAILY_LIMIT=3


# =============================================================================
# 8. RESEARCH, FORWARD EVALUATION AND COMPANY EVIDENCE
# =============================================================================
# Phase 3 bounded investigation: opt-in, shadow only, archived evidence at a frozen cutoff.
# Inherits STRATEGIST_PROVIDER (then LLM_PROVIDER) and STRATEGIST_MODEL; optional research overrides below.
# Supports every LLM_PROVIDER: ollama, vertex, gemini, openai, openai_compatible and llamacpp.
RESEARCH_MODE=disabled

# An alternate strategist/manager model pair, run in shadow on production's frozen decision inputs.
# off | shadow. Up to two extra model calls per production decision, run by the news collector.
# While on, each decision also freezes every DTE bucket's chain (about 400 KB per decision).
# An empty model inherits production's, so a challenger can change one stage only.
RESEARCH_CHALLENGER_MODE=off
# RESEARCH_CHALLENGER_STRATEGIST_MODEL=
# RESEARCH_CHALLENGER_MANAGER_MODEL=gemini-3.1-pro
# Keep the allowance near two calls per production decision (about 50 a day today). A smaller one
# leaves a backlog; decisions never evaluated count against the cohort's coverage criterion.
RESEARCH_CHALLENGER_PER_CYCLE=12
RESEARCH_CHALLENGER_DAILY_CALLS=120

# Research budgets (Phase 0 foundation, enforced by the opt-in Phase 3 worker).
# See docs/RESEARCH_PHASE0.md. A zero daily allowance authorizes no paid research.
RESEARCH_MAX_ROUNDS=2
RESEARCH_MAX_TOOL_CALLS=6
RESEARCH_MAX_SECONDS=90
RESEARCH_DAILY_COST_BUDGET=0
# true adds search_archive: PIT keyword search over this company's ingested articles and filings
# (docs/RESEARCH_PHASE3.md). Search calls count against RESEARCH_MAX_TOOL_CALLS and the daily allowance.
RESEARCH_SEARCH_ENABLED=false

# Shadow research-route theses share RESEARCH_DAILY_COST_BUDGET with planner and retrieval calls.
RESEARCH_DAILY_THESIS_CALLS=50
# Research thesis model: falls back to STRATEGIST_PROVIDER (then LLM_PROVIDER), STRATEGIST_MODEL and
# STRATEGIST_OLLAMA_HOST. Other RESEARCH_THESIS_* token limits fall back to the
# RESEARCH_PLANNER_* values. A paid model that differs from the planner's needs its own token rates.
# RESEARCH_THESIS_PROVIDER=
# RESEARCH_THESIS_MODEL=gemini-3.8-flash
# RESEARCH_THESIS_OLLAMA_HOST=http://ollama:11434
# RESEARCH_THESIS_INPUT_USD_PER_MILLION=
# RESEARCH_THESIS_OUTPUT_USD_PER_MILLION=

RESEARCH_PLANNER_PROVIDER=
RESEARCH_PLANNER_MODEL=
RESEARCH_PLANNER_HOST=http://localhost:11434
RESEARCH_DAILY_PLANNER_CALLS=100
RESEARCH_DAILY_RETRIEVAL_CALLS=600
# Every generation retry reserves a separate daily call and its cost before dispatch.
RESEARCH_PLANNER_MAX_ATTEMPTS=2
RESEARCH_PLANNER_RETRY_SECONDS=1
RESEARCH_PLANNER_MAX_INPUT_TOKENS=131072
RESEARCH_PLANNER_MAX_OUTPUT_TOKENS=4096
# Gemini 2.5 uses a thinking budget; Gemini 3+ defaults to LOW thinking level.
# minimal is sent as low to gemini-3.8-flash and later, which reject it.
RESEARCH_PLANNER_THINKING_BUDGET=1024
RESEARCH_PLANNER_THINKING_LEVEL=
RESEARCH_PLANNER_THINKING_TOKEN_RESERVATION=32768
# Vertex and openai require a positive RESEARCH_DAILY_COST_BUDGET plus model-specific rates. For gemini and
# openai_compatible the rates are optional: zero means a free plan (e.g. Mistral's), positive rates are charged
# against RESEARCH_DAILY_COST_BUDGET. ollama and llamacpp never charge; each call is still bounded by
# RESEARCH_MAX_SECONDS, which may be short for a large local model.
# Set conservative USD/million-token rates for your model/region/context tier, and update them
# whenever the planner model changes: e.g. gemini-3.8-flash is 0.75/3.75 through 2026-12-31,
# then 1.50/7.50 (thinking tokens bill at the output rate).
RESEARCH_PLANNER_INPUT_USD_PER_MILLION=0
RESEARCH_PLANNER_OUTPUT_USD_PER_MILLION=0

# Research Phase 7: forward evaluation. Shadow research only; nothing here can place an order.
# off | shadow. Rolling frozen-forward cohorts open before each production candidate, and the
# option manager polls closing marks for open shadow research positions before each close.
FORWARD_EVALUATION_MODE=shadow
FORWARD_MARK_LEAD_MINUTES=10
# Acceptance criteria are frozen into a cohort when it opens; a change applies to new cohorts only.
FORWARD_EVALUATION_WINDOW_DAYS=60
FORWARD_COHORT_CANDIDATES=10000
FORWARD_MINIMUM_PAIRED_OBSERVATIONS=100
FORWARD_MINIMUM_CLUSTERS=30

# Phase 1 primary company evidence: collector-only, no paid feed required.
# See docs/RESEARCH_PHASE1.md. Set a real application/contact User-Agent before enabling.
COMPANY_EVIDENCE_ENABLED=false
SEC_USER_AGENT=
# Companies come from current pipeline selections and investigation requests.
# COMPANY_EVIDENCE_SYMBOLS is obsolete; issuer-file keys do not select companies.
COMPANY_EVIDENCE_ISSUERS_FILE=
COMPANY_EVIDENCE_COMPANIES_PER_CYCLE=5
COMPANY_EVIDENCE_FILINGS_PER_COMPANY=3
COMPANY_EVIDENCE_REFRESH_SECONDS=10800
COMPANY_EVIDENCE_STALE_SECONDS=604800
COMPANY_EVIDENCE_TIMEOUT_SECONDS=20
COMPANY_EVIDENCE_RETRIES=2
COMPANY_EVIDENCE_DAILY_REQUESTS=500
# Analyst consensus and next earnings date: yahoo (default, free unofficial yfinance data) or none/off.
# COMPANY_EVIDENCE_CONSENSUS=yahoo

# Phase 2 discovery/review queue: disabled, shadow or enforce. Only enforce changes trading: admitted
# entry events for companies the ranking did not choose join the strategist and manager, at most
# DISCOVERY_PRODUCTION_LIMIT a cycle. Switch it on yourself after `research.py discovery-ledger`.
# Discovery follows shared pipeline interest; DISCOVERY_SYMBOLS is obsolete and ignored.
DISCOVERY_MODE=disabled
DISCOVERY_PRODUCTION_LIMIT=5
DISCOVERY_SCAN_LIMIT=20
DISCOVERY_RESCAN_SECONDS=300
# Research sessions and theses per collector cycle (these call models).
DISCOVERY_BATCH_SIZE=6
# Queue items admitted per trading cycle; no model calls. Must be at least DISCOVERY_BATCH_SIZE.
DISCOVERY_ADMISSION_BATCH_SIZE=20
DISCOVERY_DIRECT_SLOTS=2
DISCOVERY_LEASE_SECONDS=120
DISCOVERY_MAX_ATTEMPTS=3
DISCOVERY_RETRY_SECONDS=60
DISCOVERY_STALE_SECONDS=604800
# Market-wide SEC 8-K/6-K feed: companies outside the ranking that file get discovery interest.
# 0 turns it off. Needs SEC_USER_AGENT. The floor uses stored stock price and 3-month average volume.
DISCOVERY_MARKET_EVENT_LIMIT=0
DISCOVERY_MARKET_EVENT_MIN_PRICE=10
DISCOVERY_MARKET_EVENT_MIN_AVERAGE_VOLUME=500000


# =============================================================================
# 9. MARKET DATA (end-of-day option quotes)
# =============================================================================
# Shared EOD fetch allowance per database; 0 disables provider requests.
# Resets at 09:30 America/New_York. Failed attempts also use allowance.
MARKETDATA_DAILY_CREDIT_BUDGET=100
# Dedicated quote-cache service: once daily at 10:00 America/New_York.
MARKETDATA_AUTO_FETCH_ENABLED=true
MARKETDATA_AUTO_FETCH_BATCH_SIZE=100
MARKETDATA_AUTO_FETCH_ENTRY_DELAY_MINUTES=1440
MARKETDATA_AUTO_FETCH_MAX_HOLD_HOURS=168
# Wait for the complete holding window, plus this publication buffer.
MARKETDATA_AUTO_FETCH_PUBLICATION_DELAY_HOURS=24
# Avoid repeatedly requesting unresolved windows; unattempted windows come first.
MARKETDATA_AUTO_FETCH_RETRY_DAYS=7


# =============================================================================
# 10. STARTUP CHECKS, DASHBOARD, FILES AND TELEMETRY
# =============================================================================
# Startup readiness checks
# Runs one-time startup probes before the worker/news collector enter their long loops.
STARTUP_READINESS_CHECK=true
# Verifies output/status directories are writable at startup.
STARTUP_READINESS_OUTPUT_PATH_CHECK=true
# Verifies the configured LLM provider is reachable at startup.
STARTUP_READINESS_LLM_CHECK=true
# Verifies Alpaca account + clock access during worker startup.
STARTUP_READINESS_ALPACA_CHECK=true
# Optional override for the lightweight startup probe model.
# STARTUP_READINESS_MODEL=gemini-3.1-flash-lite
# Optional override for the Ollama host label used when LLM_PROVIDER=ollama.
# STARTUP_READINESS_OLLAMA_HOST=http://ollama:11434
# COLD_START_SANITY_CHECK=true

# Portfolio history API defaults
PORTFOLIO_HISTORY_PERIOD=1M
PORTFOLIO_HISTORY_TIMEFRAME=1D
PORTFOLIO_HISTORY_INTRADAY_REPORTING=market_hours
PORTFOLIO_HISTORY_PNL_RESET=per_day

# Shared runtime file locations
SCRIPT_STATUS_PATH=/shared/script_status.json
OPTION_MANAGER_STATUS_PATH=/shared/option_manager_status.json
NEWS_COLLECTOR_STATUS_PATH=/shared/news_collector_status.json
MARKETDATA_EOD_SYNC_STATUS_PATH=/shared/marketdata_eod_sync_status.json
DB_BACKUP_STATUS_PATH=/shared/db_backup_status.json
# Loop health: a status file older than the threshold is "down" (writers heartbeat every 30s),
# "running" longer than the stall limit is "stalled", and an error stays flagged for the window.
# BOT_STATUS_DOWN_THRESHOLD_SECONDS=90
# BOT_STATUS_STALL_SECONDS=21600
# BOT_STATUS_ERROR_WINDOW_SECONDS=3600
TRADE_EXECUTION_OUTPUT_PATH=/shared/trade_execution_output.json
OPTION_POSITION_MANAGEMENT_OUTPUT_PATH=/shared/option_position_management_output.json
# Shared JSON state file used to persist trailing and pending-exit state across cycles.
OPTION_POSITION_STATE_PATH=/shared/option_position_state.json

# Database storage
# Local Python defaults to Data/stock_experiment.db.
# Docker sets DB_PATH automatically to a persistent named volume.
# DB_PATH=/var/lib/stock-experiment/stock_experiment.db

# Optional scraping tuning
# WEBSCRAPING_ARTICLE_BACKEND=scrapy
# WEBSCRAPING_PLAYWRIGHT_CONCURRENCY=2
# Max pages one Playwright call renders (default 30); extra URLs are retried next run
# WEBSCRAPING_PLAYWRIGHT_MAX_PAGES=30
# WEBSCRAPING_RENDERED_EXTRACTION_WORKERS=2

# Optional anonymous startup telemetry
# Disabled by default. When enabled, the app will POST a tiny startup payload to TELEMETRY_ENDPOINT.
# Payload fields: random install_id, install_created_at, runtime, started_at, project, telemetry_version, optional release.
TELEMETRY_ENABLED=false
TELEMETRY_ENDPOINT=https://dashboard.huvle.org/api/telemetry/startup
# TELEMETRY_AUTH_TOKEN=replace_me_if_your_endpoint_requires_auth
# TELEMETRY_INSTALLATION_ID_PATH=/shared/telemetry_installation.json
# TELEMETRY_TIMEOUT_SECONDS=2.0
# TELEMETRY_PROJECT_NAME=Stock-trading-experiment
# TELEMETRY_RELEASE=
