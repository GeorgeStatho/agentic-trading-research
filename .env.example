# Alpaca
PUBLIC_KEY=your_alpaca_public_key
PRIVATE_KEY=your_alpaca_private_key
ALPACA_PAPER=true

# Google Cloud / Vertex AI
LLM_PROVIDER=vertex
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=global
VERTEX_DEFAULT_MODEL=gemini-2.5-flash
# Optional Vertex retry tuning
# VERTEX_MAX_ATTEMPTS=5
# VERTEX_RETRY_INITIAL_DELAY_SECONDS=2
# VERTEX_RETRY_MAX_DELAY_SECONDS=30
# MACRO_NEWS_BATCH_PAUSE_SECONDS=0.75

# Local Docker uses the host gcloud ADC directory automatically.
# Run `gcloud auth application-default login --scopes=https://www.googleapis.com/auth/cloud-platform`
# on the host once, then rebuild/restart the containers.
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp-sa.json

# Recommended stage split
# High-volume classification/extraction stages use Flash-Lite to keep costs down.
WORLD_NEWS_MODEL=gemini-2.5-flash-lite
MACRO_NEWS_MODEL=gemini-2.5-flash-lite
SECTOR_OPPURUNTIST_MODEL=gemini-2.5-flash-lite
INDUSTRY_OPPURUNTINST_MODEL=gemini-2.5-flash-lite
COMPANY_OPPURUNTIST_MODEL=gemini-2.5-flash-lite

# Mid-tier reasoning stage.
STRATEGIST_MODEL=gemini-2.5-flash

# Final decision stage.
MANAGER_MODEL=gemini-2.5-pro

# Startup readiness checks
# Runs one-time startup probes before the worker/news collector enter their long loops.
STARTUP_READINESS_CHECK=true
# Verifies output/status directories are writable at startup.
STARTUP_READINESS_OUTPUT_PATH_CHECK=true
# Verifies the configured LLM provider is reachable at startup.
STARTUP_READINESS_LLM_CHECK=true
# Verifies Alpaca account + clock access during worker startup.
STARTUP_READINESS_ALPACA_CHECK=true
# Optional override for the lightweight startup probe model.
# STARTUP_READINESS_MODEL=gemini-2.5-flash-lite
# Optional override for the Ollama host label used when LLM_PROVIDER=ollama.
# STARTUP_READINESS_OLLAMA_HOST=http://ollama:11434

# Portfolio history API defaults
PORTFOLIO_HISTORY_PERIOD=1M
PORTFOLIO_HISTORY_TIMEFRAME=1D
PORTFOLIO_HISTORY_INTRADAY_REPORTING=market_hours
PORTFOLIO_HISTORY_PNL_RESET=per_day

# Worker / execution settings
RUN_INTERVAL_SECONDS=10800
NEWS_COLLECTION_INTERVAL_SECONDS=10800
PIPELINE_RANKING_MAX_AGE_DAYS=7
AGENT_OPTION_ORDER_QTY=1
MANAGER_OPTION_CHAIN_LIMIT_PER_TYPE=6
MAX_DEPLOYABLE_BUYING_POWER_PCT=30
PER_ORDER_SIZING_BUYING_POWER_PCT=30
MAX_OPTION_ORDER_QTY=20
MAX_OPTION_ORDER_QTY_MULTIPLIER=50
WORKER_AUTO_MANAGE_OPTION_POSITIONS=false
OPTION_MANAGER_AUTO_MANAGE_OPTION_POSITIONS=true
AUTO_MANAGE_OPTION_POSITIONS=true
AUTO_CLOSE_OPTION_POSITIONS=true
IMMEDIATE_OPTION_EXECUTION=false
EXECUTE_MEDIUM_CONFIDENCE_TRADES=true
OPTION_POSITION_MANAGEMENT_INTERVAL_SECONDS=300
OPTION_POSITION_TAKE_PROFIT_PCT=25
OPTION_POSITION_STOP_LOSS_PCT=-20
OPTION_POSITION_EXIT_HOURS_TO_EXPIRATION=24
OPTION_POSITION_3_7_DTE_TAKE_PROFIT_PCT=30
OPTION_POSITION_3_7_DTE_STOP_LOSS_PCT=-22
OPTION_POSITION_7_14_DTE_TAKE_PROFIT_PCT=40
OPTION_POSITION_7_14_DTE_STOP_LOSS_PCT=-28
OPTION_POSITION_14_30_DTE_TAKE_PROFIT_PCT=60
OPTION_POSITION_14_30_DTE_STOP_LOSS_PCT=-35

# Trailing-profit / dynamic exit settings
# Enables the trailing-profit exit workflow for open option positions.
OPTION_POSITION_ENABLE_TRAILING_PROFIT=false
# Runs the trailing-profit workflow without submitting live sell orders.
OPTION_POSITION_TRAILING_PROFIT_DRY_RUN=false
# Allows exits when the underlying stock momentum turns unfavorable.
OPTION_POSITION_ENABLE_MOMENTUM_EXIT=false
# Start tracking momentum history only after the position's max unrealized profit reaches this ratio.
OPTION_MOMENTUM_HISTORY_ENABLE_AFTER_PNL_PCT=2.00
# Number of recent momentum samples to keep per open position.
OPTION_MOMENTUM_HISTORY_WINDOW_SIZE=10
# Minimum number of samples required before momentum-history exits are allowed.
OPTION_MOMENTUM_HISTORY_MIN_SAMPLES=5
# Full-exit threshold based on how many recent samples in the window are `bad`.
OPTION_MOMENTUM_HISTORY_BAD_COUNT_EXIT_THRESHOLD=6
# Full-exit threshold based on how many `bad` samples happen in a row.
OPTION_MOMENTUM_HISTORY_CONSECUTIVE_BAD_EXIT_THRESHOLD=3
# If option premium gives back at least this much from its tracked peak, option-price momentum is marked bad.
OPTION_PRICE_MOMENTUM_BAD_GIVEBACK_THRESHOLD=0.25
# If option premium gives back at least this much from peak but stays below the bad threshold, it is marked mixed.
OPTION_PRICE_MOMENTUM_MIXED_GIVEBACK_THRESHOLD=0.15
# Minimum option profit ratio needed for the option-price momentum helper to treat the premium as clearly good.
OPTION_PRICE_MOMENTUM_GOOD_PROFIT_THRESHOLD=0.10
# Shared JSON state file used to persist trailing and pending-exit state across cycles.
OPTION_POSITION_STATE_PATH=/shared/option_position_state.json
# Minutes before an unresolved pending exit order is considered stale.
OPTION_PENDING_EXIT_STALE_MINUTES=10
# When true, stale pending exit orders are cancelled so the manager can reevaluate cleanly.
OPTION_PENDING_EXIT_CANCEL_ON_STALE=true

# Profit threshold that must be reached before trailing protection turns on.
OPTION_TRAIL_PROTECTION_TRIGGER_PCT=0.40
# Minimum locked-in profit once trailing protection is first activated.
OPTION_TRAIL_INITIAL_FLOOR_PCT=0.10

# Profit threshold for the first partial scale-out sale.
OPTION_TRAIL_FIRST_SCALE_OUT_TRIGGER_PCT=0.55
# Fraction of the open position to sell on the first scale-out.
OPTION_TRAIL_FIRST_SCALE_OUT_FRACTION=0.50

# Profit threshold for the second partial scale-out sale.
OPTION_TRAIL_SECOND_SCALE_OUT_TRIGGER_PCT=2.00
# Fraction of the original position to sell on the second scale-out.
OPTION_TRAIL_SECOND_SCALE_OUT_FRACTION=0.25

# Bucket-specific giveback allowed after trailing protection is active.
# Higher values allow more pullback before the trailing exit fires.
# `3_7` is kept as a legacy compatibility override if that bucket is reintroduced.
OPTION_TRAIL_3_7_GIVEBACK_PCT=0.25
OPTION_TRAIL_7_14_GIVEBACK_PCT=0.35
OPTION_TRAIL_14_30_GIVEBACK_PCT=0.45
OPTION_TRAIL_30_45_GIVEBACK_PCT=0.45
OPTION_TRAIL_45_60_GIVEBACK_PCT=0.45

# Profit floors that tighten protection once a position reaches very large gains.
OPTION_TRAIL_100_FLOOR_PCT=0.60
OPTION_TRAIL_150_FLOOR_PCT=1.00
OPTION_TRAIL_200_FLOOR_PCT=1.40

# Optional: fetch a wider raw chain from Alpaca, then trim to nearest/OTM contracts.
# MANAGER_OPTION_CHAIN_FETCH_MULTIPLIER=6

# Database storage
# Local Python defaults to Data/stock_experiment.db.
# Docker sets DB_PATH automatically to a persistent named volume.
# DB_PATH=/var/lib/stock-experiment/stock_experiment.db
# COLD_START_SANITY_CHECK=true

# Shared runtime file locations
SCRIPT_STATUS_PATH=/shared/script_status.json
OPTION_MANAGER_STATUS_PATH=/shared/option_manager_status.json
TRADE_EXECUTION_OUTPUT_PATH=/shared/trade_execution_output.json
OPTION_POSITION_MANAGEMENT_OUTPUT_PATH=/shared/option_position_management_output.json

# Optional local Ollama fallback
# Uncomment these if you want to run with LLM_PROVIDER=ollama instead.
# OLLAMA_HOST=http://ollama:11434
# WORLD_NEWS_OLLAMA_HOST=http://ollama:11434
# MACRO_NEWS_OLLAMA_HOST=http://ollama:11434
# SECTOR_OPPURUNTIST_OLLAMA_HOST=http://ollama:11434
# INDUSTRY_OPPURUNTINST_OLLAMA_HOST=http://ollama:11434
# COMPANY_OPPURUNTIST_OLLAMA_HOST=http://ollama:11434
# STRATEGIST_OLLAMA_HOST=http://ollama:11434
# MANAGER_OLLAMA_HOST=http://ollama:11434

# Optional scraping tuning
# WEBSCRAPING_ARTICLE_BACKEND=scrapy
# WEBSCRAPING_PLAYWRIGHT_CONCURRENCY=2
# WEBSCRAPING_RENDERED_EXTRACTION_WORKERS=2

OPTION_SELECTOR_MODE=hybrid
ALLOW_RISKY_SIMPLE_FALLBACK=true
